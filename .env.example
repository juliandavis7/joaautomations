# Resend API key for the contact form. Create one at https://resend.com/api-keys
# Never commit the real value; this file holds the shape only.
RESEND_API_KEY=

# Where contact submissions are delivered.
CONTACT_TO=hello@joju.com

# The verified sender the form posts as. Must be a domain verified in Resend.
CONTACT_FROM=JoJu <hello@joju.com>
